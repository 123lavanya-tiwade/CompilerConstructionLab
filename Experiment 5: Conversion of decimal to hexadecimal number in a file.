#decimal.l
%{
#include <stdio.h>
#include <stdlib.h>
FILE *fp;
%}

%%
[0-9]+ {
    int n = atoi(yytext);
    fprintf(fp, "%s = %X\n", yytext, n);
}
[ \t\n]+ ;
. ;
%%

int yywrap()
{
    return 1;
}

int main()
{
    fp = fopen("output.txt", "w");

    if(fp == NULL)
    {
        printf("File cannot be opened");
        return 1;
    }

    yyin = fopen("input.txt", "r");

    if(yyin == NULL)
    {
        printf("Input file not found");
        fclose(fp);
        return 1;
    }

    yylex();

    fclose(yyin);
    fclose(fp);

    printf("Conversion completed. Check output.txt");

    return 0;
}
