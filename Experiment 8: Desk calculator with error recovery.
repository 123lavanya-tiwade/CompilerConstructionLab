#calc.l
%{
#include "y.tab.h"
#include <stdlib.h>
%}

%%
[0-9]+      { yylval = atoi(yytext); return NUMBER; }
[+\-*/()]   { return yytext[0]; }
\n          { return '\n'; }
[ \t]       ;
.           { return yytext[0]; }
%%

int yywrap()
{
    return 1;
}

#calc.y
%{
#include <stdio.h>
#include <stdlib.h>
int yylex();
int yyerror(char *s);
%}

%token NUMBER
%left '+' '-'
%left '*' '/'
%left UMINUS

%%
input:
      input line
    |
    ;

line:
      expression '\n'  { printf("Result = %d\n", $1); }
    | error '\n'       { printf("Invalid Expression\n"); yyerrok; }
    ;

expression:
      NUMBER
    | expression '+' expression  { $$ = $1 + $3; }
    | expression '-' expression  { $$ = $1 - $3; }
    | expression '*' expression  { $$ = $1 * $3; }
    | expression '/' expression
        {
            if($3 == 0)
            {
                printf("Division by zero\n");
                $$ = 0;
            }
            else
                $$ = $1 / $3;
        }
    | '-' expression %prec UMINUS { $$ = -$2; }
    | '(' expression ')'         { $$ = $2; }
    ;
%%

int yyerror(char *s)
{
    return 0;
}

int main()
{
    printf("Enter arithmetic expressions:\n");
    yyparse();
    return 0;
}
