#icg.l
%{
#include "y.tab.h"
#include <stdlib.h>
#include <string.h>
%}

%%
[0-9]+                  { yylval.str = strdup(yytext); return NUM; }
[a-zA-Z_][a-zA-Z0-9]*   { yylval.str = strdup(yytext); return ID; }
[+\-*/()]               { return yytext[0]; }
[ \t\n]                 ;
.                       ;
%%

int yywrap()
{
    return 1;
}

#icg.y
%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int temp = 1;
int yylex();
int yyerror(char *s);
%}

%union {
    char *str;
}

%token <str> NUM ID
%type <str> E

%left '+' '-'
%left '*' '/'

%%
S:
    E {
        printf("\nFinal Result = %s\n", $1);
    }
    ;

E:
      E '+' E {
          char *t = malloc(20);
          sprintf(t, "t%d", temp++);
          printf("%s = %s + %s\n", t, $1, $3);
          $$ = t;
      }
    | E '-' E {
          char *t = malloc(20);
          sprintf(t, "t%d", temp++);
          printf("%s = %s - %s\n", t, $1, $3);
          $$ = t;
      }
    | E '*' E {
          char *t = malloc(20);
          sprintf(t, "t%d", temp++);
          printf("%s = %s * %s\n", t, $1, $3);
          $$ = t;
      }
    | E '/' E {
          char *t = malloc(20);
          sprintf(t, "t%d", temp++);
          printf("%s = %s / %s\n", t, $1, $3);
          $$ = t;
      }
    | '(' E ')' { $$ = $2; }
    | NUM { $$ = $1; }
    | ID  { $$ = $1; }
    ;
%%

int yyerror(char *s)
{
    printf("Invalid Expression\n");
    return 0;
}

int main()
{
    printf("Enter arithmetic expression:\n");
    yyparse();
    return 0;
}
