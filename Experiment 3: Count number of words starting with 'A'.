#countA.l
%{
#include <stdio.h>
int count = 0;
%}

%%
[Aa][a-zA-Z0-9_]*   { count++; }
[a-zA-Z0-9_]+      ;
[ \t\n]+           ;
.                  ;
%%

int yywrap()
{
    return 1;
}

int main()
{
    FILE *fp = fopen("input.txt", "r");

    if(fp == NULL)
    {
        printf("File not found");
        return 1;
    }

    yyin = fp;
    yylex();

    printf("Number of words starting with A = %d\n", count);

    fclose(fp);
    return 0;
}

